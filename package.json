{
  "name": "jekyll-e-hyde",
  "version": "0.1.0",
  "description": "Avventura grafica in pixel art da \"The Strange Case of Dr Jekyll and Mr Hyde\"",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "validate": "tsx scripts/validate-content.ts",
    "check:story": "tsx scripts/check-story.ts",
    "shot": "tsx scripts/shot.ts",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "phaser": "^3.90.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "node-llama-cpp": "^3.22.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "it.jekyllhyde.game",
    "productName": "Jekyll e Hyde",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "!out/renderer/audio/**/*.wav",
      "package.json",
      "!**/node_modules/@node-llama-cpp/*cuda*/**"
    ],
    "extraResources": [
      {
        "from": "content",
        "to": "content"
      },
      {
        "from": "story/chapters",
        "to": "story/chapters"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ],
    "electronLanguages": [
      "it",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Jekyll-e-Hyde-Windows-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.adventure-games",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Jekyll-e-Hyde-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "maintainer": "fabiopsh",
      "synopsis": "Avventura grafica dal romanzo di Stevenson"
    },
    "artifactName": "Jekyll-e-Hyde-${os}-${arch}.${ext}",
    "dmg": {
      "artifactName": "Jekyll-e-Hyde-macOS-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "Jekyll-e-Hyde-Linux-x64.${ext}"
    },
    "deb": {
      "artifactName": "Jekyll-e-Hyde-Linux-amd64.${ext}"
    },
    "publish": null
  },
  "author": "fabiopsh",
  "homepage": "https://github.com/fabiopsh/Jekyll-e-Hyde",
  "repository": {
    "type": "git",
    "url": "https://github.com/fabiopsh/Jekyll-e-Hyde.git"
  }
}
